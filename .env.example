# Copy this file to .env before opening the devcontainer.
# Keep real credentials and machine-specific secrets in .env only.

# Non-secret defaults for local development.

# Ollama host address for Docker Desktop on Windows/macOS.
# Only needed if you use the local Ollama model option (see docs/openclaw/setup.md §5).
OLLAMA_HOST=http://host.docker.internal:11434

# Optional: higher Context7 MCP limits. Keep real keys in .env only.
# CONTEXT7_API_KEY=
