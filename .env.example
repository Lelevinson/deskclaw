# Copy this file to .env before opening the devcontainer.
# Keep real credentials and machine-specific secrets in .env only.

# Non-secret defaults for local development.

# Ollama host address for Docker Desktop on Windows/macOS.
# Only needed if you use the local Ollama model option (see docs/openclaw/setup.md §5).
OLLAMA_HOST=http://host.docker.internal:11434

# Optional: higher Context7 MCP limits. Keep real keys in .env only.
# CONTEXT7_API_KEY=

# Outbound owner notifications via Resend (shop_owner_notify). The shop MCP server
# loads these from .env (it runs with `node --env-file-if-exists=.env`). Keep the
# real RESEND_API_KEY in .env only — never commit it.
#   RESEND_API_KEY     — from resend.com → API Keys (starts with re_…).
#   OWNER_EMAIL        — where notifications go. With the free onboarding@resend.dev
#                        sender this MUST be the email you signed up to Resend with.
#   NOTIFY_FROM        — sender; onboarding@resend.dev works with no domain setup.
#   DESKCLAW_NOTIFY_MODE — "live" actually sends; anything else (default) records
#                        the composed email + audit log but makes no network call.
# RESEND_API_KEY=
# OWNER_EMAIL=
# NOTIFY_FROM=DeskClaw <onboarding@resend.dev>
# DESKCLAW_NOTIFY_MODE=dry
